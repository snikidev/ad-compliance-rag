# Copy to .env and fill in the provider you want to use for verdicts.
# Embeddings default to FastEmbed (local, no key). An LLM key is required
# only for `check`, the demo, and `eval`.

# openai | azure_openai | ollama
AD_COMPLIANCE_LLM_PROVIDER=openai
# fastembed | openai | azure_openai | ollama
AD_COMPLIANCE_EMBED_PROVIDER=fastembed
AD_COMPLIANCE_EMBED_MODEL=BAAI/bge-small-en-v1.5
AD_COMPLIANCE_LLM_MODEL=gpt-4o-mini

# OpenAI (also accepted without the AD_COMPLIANCE_ prefix)
OPENAI_API_KEY=
# AD_COMPLIANCE_OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_EMBEDDING_ENDPOINT=

# Ollama
AD_COMPLIANCE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AD_COMPLIANCE_OLLAMA_MODEL=llama3.1
AD_COMPLIANCE_OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage
AD_COMPLIANCE_LANCEDB_URI=.lancedb
AD_COMPLIANCE_LANCEDB_TABLE=guidance
AD_COMPLIANCE_DATA_DIR=data

# Retrieval
AD_COMPLIANCE_TOP_K=8
AD_COMPLIANCE_RERANK_TOP_N=5
# rrf (default, local) | llm | none
AD_COMPLIANCE_RERANKER=rrf
